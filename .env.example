# ── LLM Provider ──────────────────────────────────────────────
# Supported: "openai", "anthropic", "gemini"
LLM_PROVIDER=openai

# Model names (defaults shown)
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# API keys (set the one matching your provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Optional ──────────────────────────────────────────────────
# GitHub token for private repos (optional)
GITHUB_TOKEN=

# Storage paths (defaults to ./data)
DATA_DIR=./data

# Chunker settings
CHUNK_SIZE_LINES=80
CHUNK_OVERLAP_LINES=10
